{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitoring",
  "account_id": "6a10daf4221b92a15e6a4e3d232db007",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "SESSION_KV", "id": "4f4ecbcfe4f34e78bf5db8cfdfc1f435" }
  ],
  "vars": {
    "SUPABASE_URL": "https://jscpogjdquwcbglavurd.supabase.co",
    "VAPID_PUBLIC_KEY": "BDv6druYCAio168ZghIDx7IBIiTM4e_cA11lfJXfsR8MSAoRRhkEL3cxHzy2Btzo3x_DDcyvvAcpdRgB5LOCSA4"
  },
  // Pengingat laporan/rekonsiliasi: 09:30 UTC = 16:30 WIB setiap hari.
  "triggers": { "crons": ["30 9 * * *"] }
}